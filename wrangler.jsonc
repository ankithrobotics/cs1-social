
{
  "name": "cs1-social",
  "main": "worker.js",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cs1-database",
      "database_id": "bdb54646-a838-48f8-ad08-e0beceeb9188"
    }
  ]
}
